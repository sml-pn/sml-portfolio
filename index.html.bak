<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <meta name="description" content="SML Developer - Web Developer profissional em Trairi-CE. Criação de sites, sistemas web e e-commerces.">
    <meta name="theme-color" content="#0a0f1e">
    <title>SML Developer | Web Developer Profissional</title>
    
    <!-- Tailwind CSS LOCAL -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons LOCAL -->
    <script src="assets/libs/lucide.min.js"></script>
    
    <!-- CSS Personalizado -->
    <link rel="stylesheet" href="assets/css/style.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'dark': '#0a0f1e',
                        'neon': '#00ffff',
                        'neon-pink': '#ff00ff',
                        'neon-purple': '#8b5cf6'
                    },
                    fontFamily: {
                        'mono': ['Fira Code', 'Courier New', 'monospace']
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-dark text-white font-mono overflow-x-hidden selection:bg-neon/30 selection:text-white">

    <!-- ============ VS CODE OVERLAY ============ -->
    <div id="code-overlay" class="fixed inset-0 pointer-events-none z-0 opacity-15 md:opacity-20">
        <div class="h-full w-full overflow-hidden bg-black/50 backdrop-blur-sm">
            <div class="p-3 md:p-4 font-mono text-xs md:text-sm text-neon h-full overflow-hidden">
                <div class="flex items-center gap-2 mb-3 md:mb-4 border-b border-white/20 pb-2">
                    <div class="w-3 h-3 rounded-full bg-red-500 animate-pulse"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500 animate-pulse" style="animation-delay: 0.2s"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse" style="animation-delay: 0.4s"></div>
                    <span class="text-gray-400 text-xs ml-2">sml_developer@portfolio: ~/projetos</span>
                </div>
                <div id="code-lines" class="overflow-hidden"></div>
            </div>
        </div>
    </div>

    <!-- ============ CURSOR GLOW ============ -->
    <div id="cursor-glow" class="fixed w-64 h-64 rounded-full pointer-events-none z-50 hidden md:block" 
         style="background: radial-gradient(circle, rgba(0,255,255,0.15) 0%, rgba(0,255,255,0) 70%); transform: translate(-50%, -50%);"></div>

    <!-- ============ NAVBAR ============ -->
    <nav class="fixed w-full z-50 bg-dark/80 backdrop-blur-md border-b border-white/10">
        <div class="container mx-auto px-4 md:px-6 py-3 md:py-4 flex justify-between items-center">
            <a href="#home" class="text-xl md:text-2xl font-bold bg-gradient-to-r from-neon to-neon-pink bg-clip-text text-transparent hover:opacity-80 transition">
                &lt;SML/&gt;
            </a>
            <ul class="hidden md:flex gap-8">
                <li><a href="#home" class="hover:text-neon transition relative group">Início<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all"></span></a></li>
                <li><a href="#projetos" class="hover:text-neon transition relative group">Projetos<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all"></span></a></li>
                <li><a href="#sobre" class="hover:text-neon transition relative group">Sobre<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all"></span></a></li>
                <li><a href="#contato" class="hover:text-neon transition relative group">Contato<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all"></span></a></li>
            </ul>
            <button id="menu-btn" class="md:hidden hamburger" aria-label="Abrir menu">
                <div class="hamburger-line"></div>
                <div class="hamburger-line"></div>
                <div class="hamburger-line"></div>
            </button>
        </div>
    </nav>

    <!-- ============ MOBILE MENU ============ -->
    <div id="mobile-menu" class="fixed inset-0 bg-dark/98 backdrop-blur-lg z-40 hidden flex-col items-center justify-center gap-8 text-xl">
        <a href="#home" class="hover:text-neon transition text-2xl">🏠 Início</a>
        <a href="#projetos" class="hover:text-neon transition text-2xl">📁 Projetos</a>
        <a href="#sobre" class="hover:text-neon transition text-2xl">🌊 Sobre</a>
        <a href="#contato" class="hover:text-neon transition text-2xl">📩 Contato</a>
        <button id="close-menu" class="absolute top-6 right-6 text-2xl hover:text-neon transition">
            <i data-lucide="x-circle"></i>
        </button>
    </div>

    <!-- ============ HERO SECTION ============ -->
    <section id="home" class="min-h-screen flex items-center justify-center relative overflow-hidden pt-16">
        <div class="absolute inset-0 bg-gradient-to-br from-neon/5 via-transparent to-neon-pink/5 animate-spin-slow" style="width: 200%; height: 200%;"></div>
        <div class="container mx-auto px-6 text-center relative z-10">
            <div class="mb-6 fade-in-up">
                <span class="inline-block px-4 py-2 bg-neon/10 border border-neon/30 rounded-full text-neon text-sm mb-6">
                    🚀 Disponível para novos projetos
                </span>
            </div>
            <h1 class="text-5xl md:text-7xl font-bold mb-4 fade-in-up" style="animation-delay: 0.2s">
                <span class="bg-gradient-to-r from-neon via-neon-pink to-neon-purple bg-clip-text text-transparent animate-pulse">
                    SML Developer
                </span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 mb-8 fade-in-up" style="animation-delay: 0.4s">
                💻 Web Developer Full Stack | 🌊 Trairi-CE
            </p>
            <div class="flex gap-4 justify-center flex-wrap fade-in-up" style="animation-delay: 0.6s">
                <a href="#projetos" class="px-8 py-3 bg-gradient-to-r from-neon to-neon-pink rounded-lg font-bold hover:scale-105 transition shadow-lg shadow-neon/20">
                    <i data-lucide="rocket" class="inline w-5 h-5 mr-2"></i>Ver Projetos
                </a>
                <a href="#contato" class="px-8 py-3 border-2 border-neon rounded-lg font-bold hover:bg-neon/20 transition">
                    <i data-lucide="message-circle" class="inline w-5 h-5 mr-2"></i>Contato
                </a>
            </div>
        </div>
        <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce">
            <i data-lucide="chevrons-down" class="text-neon w-8 h-8"></i>
        </div>
    </section>

    <!-- ============ PROJETOS SECTION ============ -->
    <section id="projetos" class="py-20 px-6 relative z-10">
        <div class="container mx-auto">
            <h2 class="text-4xl font-bold text-center mb-4 bg-gradient-to-r from-neon to-neon-pink bg-clip-text text-transparent">
                <i data-lucide="folder-git-2" class="inline w-10 h-10 mr-2"></i>Projetos Realizados
            </h2>
            <p class="text-center text-gray-400 mb-12">Alguns dos meus trabalhos recentes</p>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                
                <!-- Card 1: Portfolio 3D -->
                <div class="card-3d bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:border-neon transition group">
                    <div class="h-48 bg-gradient-to-br from-neon to-neon-pink rounded-lg mb-4 flex items-center justify-center relative overflow-hidden">
                        <i data-lucide="box" class="text-white w-16 h-16 group-hover:scale-110 transition-transform"></i>
                        <div class="absolute inset-0 bg-gradient-to-t from-dark/50 to-transparent"></div>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Portfolio 3D Interativo</h3>
                    <p class="text-gray-400 mb-4">Site interativo com efeitos 3D e animações fluidas usando Three.js</p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="px-3 py-1 bg-neon/20 rounded-full text-xs font-semibold">Three.js</span>
                        <span class="px-3 py-1 bg-neon/20 rounded-full text-xs font-semibold">Tailwind</span>
                        <span class="px-3 py-1 bg-neon/20 rounded-full text-xs font-semibold">GSAP</span>
                    </div>
                    <a href="#" class="text-neon hover:underline inline-flex items-center gap-1 font-semibold">
                        Ver mais <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </div>

                <!-- Card 2: API REST -->
                <div class="card-3d bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:border-neon transition group">
                    <div class="h-48 bg-gradient-to-br from-neon-pink to-neon-purple rounded-lg mb-4 flex items-center justify-center relative overflow-hidden">
                        <i data-lucide="cloud-cog" class="text-white w-16 h-16 group-hover:scale-110 transition-transform"></i>
                        <div class="absolute inset-0 bg-gradient-to-t from-dark/50 to-transparent"></div>
                    </div>
                    <h3 class="text-xl font-bold mb-2">API REST Completa</h3>
                    <p class="text-gray-400 mb-4">Backend robusto com autenticação JWT e documentação Swagger</p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="px-3 py-1 bg-neon-pink/20 rounded-full text-xs font-semibold">Node.js</span>
                        <span class="px-3 py-1 bg-neon-pink/20 rounded-full text-xs font-semibold">Express</span>
                        <span class="px-3 py-1 bg-neon-pink/20 rounded-full text-xs font-semibold">MongoDB</span>
                    </div>
                    <a href="#" class="text-neon hover:underline inline-flex items-center gap-1 font-semibold">
                        Ver mais <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </div>

                <!-- Card 3: E-commerce -->
                <div class="card-3d bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:border-neon transition group">
                    <div class="h-48 bg-gradient-to-br from-neon-purple to-neon rounded-lg mb-4 flex items-center justify-center relative overflow-hidden">
                        <i data-lucide="shopping-cart" class="text-white w-16 h-16 group-hover:scale-110 transition-transform"></i>
                        <div class="absolute inset-0 bg-gradient-to-t from-dark/50 to-transparent"></div>
                    </div>
                    <h3 class="text-xl font-bold mb-2">E-commerce Moderno</h3>
                    <p class="text-gray-400 mb-4">Loja virtual completa com pagamento integrado via Stripe</p>
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="px-3 py-1 bg-neon-purple/20 rounded-full text-xs font-semibold">React</span>
                        <span class="px-3 py-1 bg-neon-purple/20 rounded-full text-xs font-semibold">Redux</span>
                        <span class="px-3 py-1 bg-neon-purple/20 rounded-full text-xs font-semibold">Stripe</span>
                    </div>
                    <a href="#" class="text-neon hover:underline inline-flex items-center gap-1 font-semibold">
                        Ver mais <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- ============ SOBRE SECTION ============ -->
    <section id="sobre" class="py-20 px-6 bg-white/[0.02] relative z-10">
        <div class="container mx-auto max-w-3xl text-center">
            <h2 class="text-4xl font-bold mb-8 bg-gradient-to-r from-neon to-neon-pink bg-clip-text text-transparent">
                🌊 Sobre Mim
            </h2>
            <div class="glass rounded-xl p-8 space-y-6 text-gray-300">
                <div class="flex items-center justify-center gap-4">
                    <i data-lucide="code-2" class="text-neon w-8 h-8"></i>
                    <p class="text-xl"><strong class="text-white">Web Developer Full Stack</strong></p>
                </div>
                <p class="text-lg">🚀 Transformando ideias em soluções digitais limpas e funcionais</p>
                <p class="flex items-center justify-center gap-2">
                    <i data-lucide="map-pin" class="text-neon w-5 h-5"></i>
                    📍 Trairi - Ceará
                </p>
                <a href="https://sml-developer.onrender.com" target="_blank" class="text-neon hover:underline inline-flex items-center gap-2">
                    <i data-lucide="globe" class="w-5 h-5"></i> sml-developer.onrender.com
                </a>
            </div>
        </div>
    </section>

    <!-- ============ CONTATO SECTION ============ -->
    <section id="contato" class="py-20 px-6 relative z-10">
        <div class="container mx-auto max-w-2xl">
            <h2 class="text-4xl font-bold text-center mb-4 bg-gradient-to-r from-neon to-neon-pink bg-clip-text text-transparent">
                📩 Entre em Contato
            </h2>
            <p class="text-center text-gray-400 mb-12">Tem um projeto em mente? Vamos conversar!</p>
            
            <form id="form-contato" class="space-y-6">
                <div class="relative group">
                    <i data-lucide="user" class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5 group-focus-within:text-neon transition"></i>
                    <input type="text" placeholder="Seu nome" required 
                           class="w-full pl-12 pr-4 py-4 bg-white/10 rounded-lg border border-white/20 focus:border-neon focus:outline-none transition placeholder-gray-500">
                </div>
                <div class="relative group">
                    <i data-lucide="mail" class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5 group-focus-within:text-neon transition"></i>
                    <input type="email" placeholder="Seu melhor e-mail" required 
                           class="w-full pl-12 pr-4 py-4 bg-white/10 rounded-lg border border-white/20 focus:border-neon focus:outline-none transition placeholder-gray-500">
                </div>
                <div class="relative group">
                    <i data-lucide="message-square" class="absolute left-4 top-4 text-gray-400 w-5 h-5 group-focus-within:text-neon transition"></i>
                    <textarea placeholder="Descreva seu projeto..." rows="5" required 
                              class="w-full pl-12 pr-4 py-4 bg-white/10 rounded-lg border border-white/20 focus:border-neon focus:outline-none transition placeholder-gray-500 resize-none"></textarea>
                </div>
                <button type="submit" 
                        class="w-full py-4 bg-gradient-to-r from-neon to-neon-pink rounded-lg font-bold hover:scale-[1.02] transition inline-flex items-center justify-center gap-2 shadow-lg shadow-neon/20">
                    <i data-lucide="send" class="w-5 h-5"></i> Enviar Mensagem
                </button>
            </form>

            <div class="flex justify-center gap-6 mt-12">
                <a href="#" class="social-icon text-gray-400 hover:text-neon transition" aria-label="GitHub">
                    <i data-lucide="github"></i>
                </a>
                <a href="#" class="social-icon text-gray-400 hover:text-neon-pink transition" aria-label="Instagram">
                    <i data-lucide="instagram"></i>
                </a>
                <a href="#" class="social-icon text-gray-400 hover:text-neon transition" aria-label="LinkedIn">
                    <i data-lucide="linkedin"></i>
                </a>
                <a href="#" class="social-icon text-gray-400 hover:text-neon-pink transition" aria-label="WhatsApp">
                    <i data-lucide="smartphone"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="py-8 text-center text-gray-500 border-t border-white/10 relative z-10">
        <p class="mb-2">© 2024 SML Developer | Todos os direitos reservados</p>
        <p class="text-sm">Feito com 💻, ☕ e muito código em Trairi-CE</p>
    </footer>

    <!-- ============ SCRIPTS ============ -->
    <script src="assets/js/script.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
</body>
</html>
